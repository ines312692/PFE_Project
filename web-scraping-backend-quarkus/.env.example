# -- Keycloak / BFF Authentication --------------------------------------------
KEYCLOAK_URL=http://localhost:8180
KEYCLOAK_REALM=elyadata
BFF_CLIENT_ID=scraping-bff
BFF_CLIENT_SECRET=bff-dev-secret-change-in-prod
BFF_CALLBACK_URI=http://localhost:4200/v1/auth/callback
FRONTEND_URL=http://localhost:4200
OIDC_TLS_VERIFICATION=none

# -- HTTP Server --------------------------------------------------------------
HTTP_PORT=8080
CORS_ALLOWED_ORIGINS=http://localhost:4200

# -- Scraping Python Service --------------------------------------------------
SCRAPING_PYTHON_URL=http://localhost:8000

# -- Database (prod only — dev uses hardcoded localhost:5432) -----------------
