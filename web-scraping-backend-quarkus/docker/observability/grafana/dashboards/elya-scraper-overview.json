{
  "uid": "elya-scraper-overview",
  "title": "Elya Scraper — Vue d'ensemble",
  "description": "Metriques Prometheus + logs Loki. Plateforme de scraping configurable assistee par IA.",
  "tags": [
    "elya",
    "scraping",
    "pfe"
  ],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 3,
  "editable": true,
  "refresh": "10s",
  "time": {
    "from": "now-1h",
    "to": "now"
  },
  "templating": {
    "list": []
  },
  "annotations": {
    "list": []
  },
  "panels": [
    {
      "type": "row",
      "title": "Logs — volume et erreurs (Loki)",
      "collapsed": false,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 0
      },
      "panels": []
    },
    {
      "type": "stat",
      "title": "Erreurs / min",
      "description": "Lignes de niveau ERROR par minute sur 5 min.",
      "datasource": {
        "type": "loki",
        "uid": "elya-loki"
      },
      "gridPos": {
        "h": 4,
        "w": 6,
        "x": 0,
        "y": 1
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "loki",
            "uid": "elya-loki"
          },
          "expr": "sum(rate({job=\"elya-scraper\", level=\"ERROR\"}[5m])) * 60",
          "legendFormat": "Erreurs / min",
          "queryType": "range"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "decimals": 1,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "orange",
                "value": 1
              },
              {
                "color": "red",
                "value": 10
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "colorMode": "value",
        "graphMode": "area",
        "textMode": "auto",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        }
      }
    },
