    {
      "type": "logs",
      "title": "Dernieres erreurs et avertissements",
      "description": "Cliquer sur une ligne pour depiler les champs JSON (loggerName, threadName, stackTrace).",
      "datasource": {
        "type": "loki",
        "uid": "elya-loki"
      },
      "gridPos": {
        "h": 12,
        "w": 24,
        "x": 0,
        "y": 21
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "loki",
            "uid": "elya-loki"
          },
          "expr": "{job=\"elya-scraper\", level=~\"ERROR|WARN\"} | json | line_format \"{{.loggerName}} — {{.message}}\"",
          "queryType": "range"
        }
      ],
      "options": {
        "showTime": true,
        "showLabels": false,
        "showCommonLabels": false,
        "wrapLogMessage": true,
        "prettifyLogMessage": false,
        "enableLogDetails": true,
        "dedupStrategy": "none",
        "sortOrder": "Descending"
