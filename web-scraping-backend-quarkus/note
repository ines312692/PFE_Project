private ABrowser resolveBrowser(InternalScrapeRequest request) {
        if (requiresSeleniumByProbe(request.getTargetUrl())) {
            log.info("[ENGINE] Anti-bot detected → SeleniumBrowser (stealth)");
            return new SeleniumBrowser(asStealth(request));
        }
        log.info("[ENGINE] Standard/JS site → PlaywrightBrowser");
        return new PlaywrightBrowser(request);
    }



