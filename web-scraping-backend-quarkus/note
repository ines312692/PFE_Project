curl -s -c cookies.txt \
  -d "username=tomsmith&password=SuperSecretPassword!" \
  https://the-internet.herokuapp.com/authenticate > /dev/null

awk '
  BEGIN { print "{\"cookies\":["; first=1 }
  {
    line=$0
    sub(/^#HttpOnly_/, "", line)
    if (line ~ /^#/ || line ~ /^[[:space:]]*$/) next
    n=split(line, f, "\t")
    if (n < 7) next
    if (!first) printf ",\n"; first=0
    val=f[7]
    gsub(/%0A/, "", val)          # ← retire les retours-ligne encodés
    printf "  {\"name\":\"%s\",\"value\":\"%s\",\"domain\":\"%s\",\"path\":\"%s\",\"expires\":-1,\"httpOnly\":true,\"secure\":true,\"sameSite\":\"Lax\"}", f[6], val, f[1], f[3]
  }
  END { print "\n],\"origins\":[]}" }
' cookies.txt > storage_state.json

cat storage_state.json



