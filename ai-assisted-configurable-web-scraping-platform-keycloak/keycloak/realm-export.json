{
  "realm": "elyadata",
  "enabled": true,
  "sslRequired": "external",
  "registrationAllowed": true,
  "loginWithEmailAllowed": true,
  "resetPasswordAllowed": true,
  "accessTokenLifespan": 900,
  "ssoSessionMaxLifespan": 36000,
  "verifyEmail": true,
  "smtpServer": {
    "host": "mailhog",
    "port": "1025",
    "from": "no-reply@elyadata.com",
    "fromDisplayName": "Elyadata",
    "ssl": "false",
    "starttls": "false"
  },
  "roles": {
    "realm": [
      { "name": "ADMIN" },
      { "name": "OPERATOR" },
      { "name": "READER" }
    ]
  },
  "clients": [
    {
      "clientId": "scraping-bff",
      "name": "Scraping BFF (Backend For Frontend)",
      "enabled": true,
      "publicClient": false,
      "clientAuthenticatorType": "client-secret",
      "secret": "bff-dev-secret-change-in-prod",
      "standardFlowEnabled": true,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": false,
      "redirectUris": [
        "http://localhost:8080/v1/auth/callback",
        "http://localhost:4200/v1/auth/callback"
      ],
      "webOrigins": [
        "http://localhost:8080",
        "http://localhost:4200"
      ],
      "attributes": {
        "post.logout.redirect.uris": "http://localhost:4200/*"
      },
      "defaultClientScopes": [
        "web-origins",
        "acr",
        "profile",
        "roles",
        "email"
      ],
      "protocolMappers": [
        {
          "name": "realm-roles-mapper",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-realm-role-mapper",
          "consentRequired": false,
          "config": {
            "multivalued": "true",
            "claim.name": "realm_access.roles",
            "jsonType.label": "String",
            "id.token.claim": "true",
            "access.token.claim": "true",
            "userinfo.token.claim": "true"
          }
        }
      ]
    }
  ],
  "users": [
    {
      "username": "admin",
      "email": "admin@elyadata.com",
      "enabled": true,
      "emailVerified": true,
      "credentials": [{ "type": "password", "value": "admin123", "temporary": false }],
      "realmRoles": ["ADMIN"]
    },
    {
      "username": "operator",
      "email": "operator@elyadata.com",
      "enabled": true,
      "emailVerified": true,
      "credentials": [{ "type": "password", "value": "operator123", "temporary": false }],
      "realmRoles": ["OPERATOR"]
    }
  ]
}