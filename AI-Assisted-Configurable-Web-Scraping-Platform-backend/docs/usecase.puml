@startuml DiagrammeCasUtilisation_PFE_WebScraping

' ============================================================
'  CONFIGURATION GLOBALE
' ============================================================
skinparam monochrome            true
skinparam shadowing             false
skinparam defaultFontName       "Arial"
skinparam defaultFontSize       12
skinparam usecaseBorderThickness 1.5
skinparam ArrowThickness        1.2
skinparam nodesep               100
skinparam ranksep               120
skinparam packagePadding        30

left to right direction

' ============================================================
'  ACTEURS
' ============================================================

actor "Utilisateur\nNon-Technicien" as UserNT
actor "Technicien"                  as Tech
actor "Administrateur"              as Admin

' -- Généralisation : Tech hérite de UserNT, Admin hérite de Tech --
Tech   --|> UserNT
Admin  --|> Tech

' ============================================================
'  FRONTIÈRE DU SYSTÈME
' ============================================================

rectangle "AI-Assisted Configurable Web Scraping Platform" {

  ' ─── Authentification ────────────────────────────────────
  usecase "S'authentifier"                                    as UC_LOGIN

  ' ─── Gestion des Jobs ────────────────────────────────────
  usecase "Créer un job\nde scraping"                         as UC_J1
  usecase "Utiliser un template\nprédéfini"                   as UC_J2
  usecase "Planifier un job\n(cron / webhook)"                as UC_J4
  usecase "Lancer / Arrêter\nun job"                          as UC_J5
  usecase "Exécuter en mode\ntest (dry-run)"                  as UC_J6

  ' ─── Crawling & Extraction ───────────────────────────────
  usecase "Configurer le schéma\nd'extraction"                as UC_E1
  usecase "Extraction assistée\npar LLM"                      as UC_E3
  usecase "Configurer la\nnavigation (pagination,\nprofondeur, filtres)" as UC_E4

  ' ─── Anti-Bot ────────────────────────────────────────────
  usecase "Configurer les\nstratégies anti-bot"               as UC_AB

  ' ─── Nettoyage & Transformation ──────────────────────────
  usecase "Configurer le nettoyage\net la normalisation"      as UC_D1
  usecase "Enrichissement IA\n(KPIs, sentiment, résumé)"      as UC_D5

  ' ─── Pipeline ETL ────────────────────────────────────────
  usecase "Configurer le\npipeline ETL"                       as UC_ETL1
  usecase "Exporter les données"                              as UC_ETL3

  ' ─── Monitoring ─────────────────────────────────────────
  usecase "Consulter le\ndashboard"                           as UC_M1
  usecase "Consulter les logs\net alertes"                    as UC_M2
  usecase "Visualiser les\ndonnées extraites"                 as UC_M3

  ' ─── Administration ─────────────────────────────────────
  usecase "Gérer utilisateurs\net rôles (RBAC)"               as UC_A1
  usecase "Gérer l'infrastructure\net les plugins"            as UC_A6

}

' ============================================================
'  ASSOCIATIONS — Utilisateur Non-Technicien
' ============================================================

UserNT -- UC_LOGIN
UserNT -- UC_J2
UserNT -- UC_J5
UserNT -- UC_M1
UserNT -- UC_M3
UserNT -- UC_ETL3

' ============================================================
'  ASSOCIATIONS — Technicien (hérite de UserNT)
' ============================================================

Tech -- UC_J1
Tech -- UC_J4
Tech -- UC_J6
Tech -- UC_E1
Tech -- UC_E3
Tech -- UC_E4
Tech -- UC_AB
Tech -- UC_D1
Tech -- UC_D5
Tech -- UC_ETL1
Tech -- UC_M2

' ============================================================
'  ASSOCIATIONS — Administrateur (hérite de Technicien)
' ============================================================

Admin -- UC_A1
Admin -- UC_A6

' ============================================================
'  RELATIONS INCLUDE / EXTEND
' ============================================================

UC_J4  ..> UC_J1   : <<include>>
UC_J6  ..> UC_J1   : <<extend>>
UC_E3  ..> UC_E1   : <<extend>>
UC_D5  ..> UC_D1   : <<extend>>
UC_ETL3 ..> UC_ETL1 : <<include>>

@enduml