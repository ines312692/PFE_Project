@startuml
scale max 4000 width
skinparam ranksep 25
skinparam nodesep 30
skinparam dpi 150
skinparam DefaultFontSize 16
skinparam nodesep 40
skinparam ranksep 35

skinparam backgroundColor white
skinparam activity {
  BackgroundColor #D6E4FF
  BorderColor #1565C0
  FontColor black
  FontSize 15
}
skinparam activityDiamond {
  BackgroundColor #2196F3
  BorderColor #1565C0
  FontSize 14
}
skinparam swimlane {
  BorderColor #1565C0
  TitleBackgroundColor #2196F3
  TitleFontColor white
  TitleFontSize 16
}

title Gestion des invitations de membres

|Administrateur du projet|
start
:Saisir l'email du membre et sélectionner son rôle;
:Soumettre l'invitation;

|Backend|
:Vérifier l'authentification;

if (Utilisateur cible existe ?) then (Non)
  :Retourner une erreur métier\n(utilisateur introuvable);
  |Administrateur du projet|
  :Afficher le message d'erreur;
  stop
else (Oui)
  |Backend|
  if (Déjà membre ou invitation en attente ?) then (Oui)
    :Retourner une erreur métier\n(invitation impossible);
    |Administrateur du projet|
    :Afficher le message d'erreur;
    stop
  else (Non)
    |Backend|
    :Créer l'invitation avec le statut PENDING;
    :Construire l'événement de notification;

    |NotificationBroadcaster (SSE)|
    :Rechercher la connexion SSE active du destinataire;
    :Émettre l'événement SSE en temps réel;

    |Membre invité|
    :Recevoir la notification en temps réel;
    :Consulter l'invitation (accepter / refuser);
    stop
  endif
endif

@enduml