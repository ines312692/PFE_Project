@startuml seqLlmExtraction
'=============================================================
'  Diagramme de séquence — Extraction assistée par LLM (Sprint 4)
'  De la soumission de la description au retour des entités
'=============================================================

skinparam shadowing false
skinparam sequenceMessageAlign center
skinparam defaultFontSize 18
skinparam sequence {
    ArrowColor #2E75B6
    LifeLineBorderColor #2E75B6
    ParticipantBorderColor #2E75B6
    ParticipantBackgroundColor #F8FBFF
    ActorBorderColor #2E75B6
    ArrowFontSize 18
    ParticipantFontSize 18
    ActorFontSize 18
}

actor "Utilisateur" as User
participant "Frontend" as FE
participant "SchemaAssistController" as Ctrl
participant "LlmSecurityGuard" as Guard
participant "LlmExtractionService" as Service
participant "API LLM externe" as LLM
database "Base de données" as DB

User -> FE : Définit le schéma + description en langage naturel
FE -> Ctrl : 1 : POST /schema (champs, description)
activate Ctrl

Ctrl -> Guard : 2 : validate(description)
activate Guard

alt description sûre
    Guard --> Ctrl : 3 : validation OK
    deactivate Guard

    Ctrl -> Service : 4 : extract(html, schéma)
    activate Service
    Service -> Service : 5 : sanitize(html)
    Service -> LLM : 6 : prompt + contenu nettoyé
    activate LLM
    LLM --> Service : 7 : entités extraites (JSON)
    deactivate LLM
    Service -> Service : 8 : valide la structure vs schéma
    Service --> Ctrl : 9 : entités validées
    deactivate Service

    Ctrl -> DB : 10 : enregistre le schéma
    Ctrl --> FE : 11 : schéma sauvegardé + résultats
    FE --> User : 12 : entités sémantiques affichées
else tentative d'injection détectée
    Guard --> Ctrl : 13 : règles violées
    Ctrl --> FE : 14 : soumission refusée
    FE --> User : 15 : affichage des règles violées
end

deactivate Ctrl

@enduml