@startuml
skinparam backgroundColor white
skinparam activityDiamondBackgroundColor #EAF0FB
skinparam activityBackgroundColor #F5F8FE
skinparam activityBorderColor #2E59A7
skinparam activityDiamondBorderColor #2E59A7

title Configuration et exécution du pipeline de traitement

start

:L'utilisateur accède à la configuration du pipeline;
:Sélectionne et ordonne les étapes de traitement;
:Configure les paramètres de chaque étape;
:Définit la destination d'export;
:Lance le pipeline;

repeat
  :Applique l'étape courante sur les données;

  if (Étape en échec ?) then (oui)
    :Journalise l'erreur;
    :Génère un rapport partiel;
    stop
  else (non)
  endif

repeat while (Étapes restantes ?) is (oui) not (non)

:Charge les données vers la destination;
:Génère le rapport de qualité;

stop
@enduml