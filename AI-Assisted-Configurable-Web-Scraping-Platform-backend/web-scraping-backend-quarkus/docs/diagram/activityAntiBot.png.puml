@startuml
skinparam backgroundColor white
skinparam activityDiamondBackgroundColor #EAF0FB
skinparam activityBackgroundColor #F5F8FE
skinparam activityBorderColor #2E59A7
skinparam activityDiamondBorderColor #2E59A7

start

:Analyser le site cible;
note right: protections détectées\n+ score de difficulté

:Choisir un proxy dans le réservoir;
:Activer le mode furtif\n(empreinte navigateur + requêtes);

repeat
  :Envoyer la requête vers le site\n(comportement humain simulé);

  if (Requête bloquée\nou proxy défaillant ?) then (oui)
    :Écarter le proxy courant;
    :Sélectionner un nouveau proxy;
  else (non)
  endif

repeat while (Requête réussie ?) is (non) not (oui)

if (Défi de vérification\nprésent ?) then (oui)
  :Tenter la résolution automatique\n(solveur dédié → pilote visuel);
  if (Résolu automatiquement ?) then (non)
    :Demander une intervention humaine;
    if (Défi levé à temps ?) then (non)
      :Interrompre la collecte;
      stop
    else (oui)
    endif
  else (oui)
  endif
else (non)
endif

:Charger et parcourir la page\n(défilement, navigation humaine);
:Extraire les données;

stop
@enduml